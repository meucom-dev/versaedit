{
  "name": "versaedit",
  "version": "0.0.0",
  "description": "VersaEdit — Rich Text Editor for Web Applications",
  "license": "MIT",
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "contenteditable",
    "react",
    "html",
    "typescript"
  ],
  "homepage": "https://github.com/meucom-dev/versaedit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meucom-dev/versaedit.git"
  },
  "bugs": {
    "url": "https://github.com/meucom-dev/versaedit/issues"
  },
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/versaedit.js",
  "module": "./dist/versaedit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/versaedit.js"
    },
    "./versaedit.css": "./dist/versaedit.css",
    "./versaedit-content.css": "./dist/versaedit-content.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src playground tests examples docs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"examples/*/{src,app}/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"docs/recipes/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"examples/*/{src,app}/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"docs/recipes/**/*.ts\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "dompurify": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.11"
  }
}
