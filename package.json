{
  "name": "versaedit",
  "version": "0.0.0",
  "description": "VersaEdit — Rich Text Editor for Web Applications",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/versaedit.js",
  "module": "./dist/versaedit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/versaedit.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src playground",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "dompurify": "^3.2.0"
  },
  "devDependencies": {
    "@coreui/coreui": "5.9.0",
    "@coreui/icons": "3.1.0",
    "@coreui/icons-react": "2.3.0",
    "@coreui/react": "5.13.0",
    "@eslint/js": "^9.39.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
